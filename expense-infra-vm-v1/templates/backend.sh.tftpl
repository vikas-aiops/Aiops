#!/bin/bash
# expense-backend (RHEL 9): Node.js API under systemd.
# Rendered by Terraform templatefile(); safe to re-run.
# Reaches MySQL by name (${db_host}), never by IP.

mkdir -p /var/log/expense
exec > >(tee -a /var/log/expense/setup.log) 2>&1

VALIDATE() {
  if [ "$1" -ne 0 ]; then
    echo "$(date '+%F %T') $2 ... FAILURE"
    exit 1
  else
    echo "$(date '+%F %T') $2 ... SUCCESS"
  fi
}

# Installs only the packages that are not already present (never upgrades).
INSTALL_MISSING() {
  local missing=""
  for p in "$@"; do rpm -q "$p" > /dev/null 2>&1 || missing="$missing $p"; done
  if [ -z "$missing" ]; then
    echo "$(date '+%F %T') packages $* already installed ... SUCCESS"
    return 0
  fi
  dnf install -y --setopt=install_weak_deps=False $missing
  VALIDATE $? "install$missing"
}

echo "===== expense-backend setup started $(date) ====="

HOSTNAME_NEW="${hostname}"
NODE_MAJOR="${node_version}"
REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
APP_DIR="/opt/expense/backend"

# ---- hostname (kept across reboots) -------------------------------------------
hostnamectl set-hostname "$HOSTNAME_NEW"
VALIDATE $? "set hostname $HOSTNAME_NEW"
grep -q " $HOSTNAME_NEW\$" /etc/hosts || echo "127.0.1.1 $HOSTNAME_NEW" >> /etc/hosts
VALIDATE $? "add hostname to /etc/hosts"
echo "preserve_hostname: true" > /etc/cloud/cloud.cfg.d/99-expense-hostname.cfg
VALIDATE $? "tell cloud-init to keep the hostname"

# ---- 2 GB swap (dd, not fallocate: swap files must not be sparse on XFS) -------
if ! swapon --show | grep -q /swapfile; then
  [ -f /swapfile ] || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  VALIDATE $? "create 2 GB swap"
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap defaults 0 0' >> /etc/fstab
else
  echo "swap already on, skipping"
fi

# ---- Node.js (NodeSource) and git ----------------------------------------------
# Install only what this VM needs: no system update or upgrade (too slow for a
# lab that is rebuilt daily), and nothing already on the AMI is touched (git
# ships with it; `dnf install git` would upgrade it).
#
# Node.js comes from the NodeSource repo ONLY (every other repo disabled), so
# dnf never downloads the large RHEL repo metadata. The repo file is the same
# one NodeSource's setup script writes, minus its extra N|Solid repo.
if node --version 2>/dev/null | grep -q "^v$NODE_MAJOR\."; then
  echo "Node.js $(node --version) already installed, skipping"
else
  ARCH="$(uname -m)"
  cat > /etc/yum.repos.d/nodesource-nodejs.repo <<EOF
[nodesource-nodejs]
name=Node.js Packages for $ARCH - $NODE_MAJOR
baseurl=https://rpm.nodesource.com/pub_$NODE_MAJOR.x/nodistro/nodejs/$ARCH
priority=9
enabled=1
gpgcheck=1
gpgkey=https://rpm.nodesource.com/gpgkey/ns-operations-public.key
module_hotfixes=1
EOF
  VALIDATE $? "add NodeSource repository for Node.js $NODE_MAJOR"
  dnf install -y --setopt=install_weak_deps=False --disablerepo='*' --enablerepo=nodesource-nodejs nodejs
  VALIDATE $? "install Node.js $NODE_MAJOR"
fi
node --version | grep -q "^v$NODE_MAJOR\."
VALIDATE $? "Node.js major version is $NODE_MAJOR"
echo "node $(node --version), npm $(npm --version)"

INSTALL_MISSING git

# ---- service account ------------------------------------------------------------
if id expense > /dev/null 2>&1; then
  echo "user expense exists, skipping"
else
  useradd --system --home-dir /opt/expense --shell /sbin/nologin expense
  VALIDATE $? "create system user expense"
fi
mkdir -p /opt/expense /etc/expense
chown expense:expense /opt/expense

# ---- application ---------------------------------------------------------------
if [ -d "$APP_DIR/.git" ]; then
  echo "$APP_DIR exists, fetching $REPO_REF"
  git -C "$APP_DIR" fetch --depth 1 origin "$REPO_REF" && git -C "$APP_DIR" checkout --force FETCH_HEAD
  VALIDATE $? "update backend repo to $REPO_REF"
else
  git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$APP_DIR"
  VALIDATE $? "clone $REPO_URL at $REPO_REF"
fi
chown -R expense:expense "$APP_DIR"

cd "$APP_DIR" && sudo -u expense -H npm ci --omit=dev
VALIDATE $? "npm ci --omit=dev"

# ---- configuration: env vars only (app contract) ---------------------------------
# Values come from Terraform. backend_extra_env entries come last, so they
# override anything above.
cat > /etc/expense/backend.env <<EOF
PORT=${port}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
JWT_SECRET=${jwt_secret}
NODE_ENV=production
APP_REF=${repo_ref}
%{ for key, value in extra_env ~}
${key}=${value}
%{ endfor ~}
EOF
VALIDATE $? "write /etc/expense/backend.env"
chown expense:expense /etc/expense/backend.env && chmod 600 /etc/expense/backend.env
VALIDATE $? "restrict /etc/expense/backend.env to expense, mode 600"

if systemctl is-active --quiet firewalld; then
  firewall-cmd --permanent --add-port=${port}/tcp && firewall-cmd --reload
  VALIDATE $? "open ${port} in firewalld"
fi

# ---- systemd -----------------------------------------------------------------------
# Restart=always: the backend tolerates MySQL not being ready yet, so there is
# no hard ordering between VMs.
cat > /etc/systemd/system/expense-backend.service <<'UNIT'
[Unit]
Description=Expense backend (Node.js API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=expense
Group=expense
WorkingDirectory=/opt/expense/backend
EnvironmentFile=/etc/expense/backend.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT
VALIDATE $? "write expense-backend.service"

systemctl daemon-reload
VALIDATE $? "systemctl daemon-reload"
systemctl enable expense-backend
VALIDATE $? "enable expense-backend"
systemctl restart expense-backend
VALIDATE $? "start expense-backend"

# ---- check: ready means the DB answered -------------------------------------------
# MySQL may still be installing on its own VM; wait up to ~5 minutes.
READY=1
for i in $(seq 1 60); do
  if curl -f --max-time 3 http://127.0.0.1:${port}/api/health/ready; then
    echo
    READY=0
    break
  fi
  echo "attempt $i/60: backend not ready yet (MySQL at ${db_host} may still be starting)"
  sleep 5
done
VALIDATE $READY "GET /api/health/ready"

echo "===== EXPENSE SETUP COMPLETE $(date) ====="
