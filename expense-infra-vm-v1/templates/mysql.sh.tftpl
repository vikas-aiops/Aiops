#!/bin/bash
# expense-mysql (RHEL 9): MySQL 8 + schema migrations from the mysql repo.
# Rendered by Terraform templatefile(); safe to re-run.

mkdir -p /var/log/expense
exec > >(tee -a /var/log/expense/setup.log) 2>&1

VALIDATE() {
  if [ "$1" -ne 0 ]; then
    echo "$(date '+%F %T') $2 ... FAILURE"
    exit 1
  else
    echo "$(date '+%F %T') $2 ... SUCCESS"
  fi
}

# Installs only the packages that are not already present (never upgrades).
INSTALL_MISSING() {
  local missing=""
  for p in "$@"; do rpm -q "$p" > /dev/null 2>&1 || missing="$missing $p"; done
  if [ -z "$missing" ]; then
    echo "$(date '+%F %T') packages $* already installed ... SUCCESS"
    return 0
  fi
  dnf install -y --setopt=install_weak_deps=False $missing
  VALIDATE $? "install$missing"
}

echo "===== expense-mysql setup started $(date) ====="

HOSTNAME_NEW="${hostname}"
DB_NAME="${db_name}"
DB_USER="${db_user}"
DB_PASSWORD="${db_password}"
ROOT_PASSWORD="${mysql_root_password}"
REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
APP_DIR="/opt/expense/mysql"

# ---- hostname (kept across reboots) -------------------------------------------
hostnamectl set-hostname "$HOSTNAME_NEW"
VALIDATE $? "set hostname $HOSTNAME_NEW"
grep -q " $HOSTNAME_NEW\$" /etc/hosts || echo "127.0.1.1 $HOSTNAME_NEW" >> /etc/hosts
VALIDATE $? "add hostname to /etc/hosts"
echo "preserve_hostname: true" > /etc/cloud/cloud.cfg.d/99-expense-hostname.cfg
VALIDATE $? "tell cloud-init to keep the hostname"

# ---- 2 GB swap (dd, not fallocate: swap files must not be sparse on XFS) -------
if ! swapon --show | grep -q /swapfile; then
  [ -f /swapfile ] || dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
  chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  VALIDATE $? "create 2 GB swap"
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap defaults 0 0' >> /etc/fstab
else
  echo "swap already on, skipping"
fi

# ---- packages --------------------------------------------------------------------
# Install only what this VM needs. No system update or upgrade (too slow for a
# lab that is rebuilt daily), and packages already on the AMI (git) are left
# alone: `dnf install` would otherwise upgrade them.
INSTALL_MISSING mysql-server git

# ---- listen on all interfaces (the security group restricts who connects) ------
cat > /etc/my.cnf.d/zz-expense.cnf <<'CNF'
[mysqld]
bind-address = 0.0.0.0
CNF
VALIDATE $? "set bind-address = 0.0.0.0"

if systemctl is-active --quiet firewalld; then
  firewall-cmd --permanent --add-service=mysql && firewall-cmd --reload
  VALIDATE $? "open 3306 in firewalld"
fi

systemctl enable mysqld
VALIDATE $? "enable mysqld"
systemctl restart mysqld
VALIDATE $? "start mysqld"

# ---- root password ----------------------------------------------------------------
# RHEL's root@localhost starts with an empty password. Set one once, then keep
# it in /root/.my.cnf so later mysql commands (and re-runs) can log in.
# cloud-init runs this script without HOME=/root, so the mysql client would not
# find /root/.my.cnf by itself: every root command passes it explicitly.
MYSQL_ROOT="mysql --defaults-extra-file=/root/.my.cnf"
if [ ! -f /root/.my.cnf ]; then
  mysql -u root -e "ALTER USER 'root'@'localhost' IDENTIFIED BY '$ROOT_PASSWORD';"
  VALIDATE $? "set MySQL root password"
  cat > /root/.my.cnf <<EOF
[client]
user=root
password=$ROOT_PASSWORD
EOF
  chmod 600 /root/.my.cnf
  VALIDATE $? "write /root/.my.cnf"
else
  echo "root password already set, skipping"
fi

# ---- database and application user ---------------------------------------------
# 10.0.% = anywhere in the VPC (the backend). 127.0.0.1 / localhost = migrations
# and the local check below. Privileges on DB_NAME only.
$MYSQL_ROOT <<SQL
CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE USER IF NOT EXISTS '$DB_USER'@'10.0.%'     IDENTIFIED BY '$DB_PASSWORD';
CREATE USER IF NOT EXISTS '$DB_USER'@'127.0.0.1'  IDENTIFIED BY '$DB_PASSWORD';
CREATE USER IF NOT EXISTS '$DB_USER'@'localhost'  IDENTIFIED BY '$DB_PASSWORD';
ALTER USER '$DB_USER'@'10.0.%'    IDENTIFIED BY '$DB_PASSWORD';
ALTER USER '$DB_USER'@'127.0.0.1' IDENTIFIED BY '$DB_PASSWORD';
ALTER USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASSWORD';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'10.0.%';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'127.0.0.1';
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;
SQL
VALIDATE $? "create database $DB_NAME and user $DB_USER"

# ---- migrations from the mysql repo ------------------------------------------------
mkdir -p /opt/expense
if [ -d "$APP_DIR/.git" ]; then
  echo "$APP_DIR exists, fetching $REPO_REF"
  git -C "$APP_DIR" fetch --depth 1 origin "$REPO_REF" && git -C "$APP_DIR" checkout --force FETCH_HEAD
  VALIDATE $? "update mysql repo to $REPO_REF"
else
  git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$APP_DIR"
  VALIDATE $? "clone $REPO_URL at $REPO_REF"
fi

DB_HOST=127.0.0.1 DB_PORT=3306 DB_NAME="$DB_NAME" DB_USER="$DB_USER" DB_PASSWORD="$DB_PASSWORD" bash "$APP_DIR/migrate.sh"
VALIDATE $? "run migrate.sh"

# ---- check: the app user can query over TCP ------------------------------------
MYSQL_PWD="$DB_PASSWORD" mysql -h 127.0.0.1 -u "$DB_USER" "$DB_NAME" -e "SELECT 1;"
VALIDATE $? "SELECT 1 as $DB_USER over TCP"

echo "===== EXPENSE SETUP COMPLETE $(date) ====="
